{{ 'ghlam-about-page.css' | asset_url | stylesheet_tag }}

<section
  id="GhlamAbout-{{ section.id }}"
  class="ghlam-about"
  style="
    --ghlam-about-bg: {{ section.settings.background_color }};
    --ghlam-about-text: {{ section.settings.text_color }};
    --ghlam-about-muted: {{ section.settings.muted_text_color }};
    --ghlam-about-border: {{ section.settings.border_color }};
    --ghlam-about-accent: {{ section.settings.accent_color }};
    --ghlam-about-max-width: {{ section.settings.max_width }}px;
    --ghlam-about-section-gap: {{ section.settings.section_gap }}px;
  "
>
  <div class="ghlam-about__container">

    {%- comment -%}
      FIRST EDITORIAL SECTION
    {%- endcomment -%}

    <div class="ghlam-about__row ghlam-about__row--hero">
      <div class="ghlam-about__content ghlam-about__content--hero">
        {% if section.settings.eyebrow != blank %}
          <p class="ghlam-about__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="ghlam-about__heading">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.intro_text != blank %}
          <div class="ghlam-about__text rte">
            {{ section.settings.intro_text }}
          </div>
        {% endif %}
      </div>

      <div class="ghlam-about__media ghlam-about__media--hero">
        {% if section.settings.hero_image != blank %}
          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag:
              loading: 'eager',
              sizes: '(max-width: 699px) 100vw, 66vw',
              widths: '400,600,800,1000,1200,1500,1800',
              class: 'ghlam-about__image',
              alt: section.settings.hero_image.alt
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'ghlam-about__placeholder' }}
        {% endif %}
      </div>
    </div>

    {%- comment -%}
      SECOND EDITORIAL SECTION
    {%- endcomment -%}

    <div class="ghlam-about__row ghlam-about__row--story">
      <div class="ghlam-about__content ghlam-about__content--story">
        {% if section.settings.story_heading != blank %}
          <h2 class="ghlam-about__subheading">
            {{ section.settings.story_heading }}
          </h2>
        {% endif %}

        {% if section.settings.story_text != blank %}
          <div class="ghlam-about__text rte">
            {{ section.settings.story_text }}
          </div>
        {% endif %}
      </div>

      <div class="ghlam-about__media ghlam-about__media--story">
        {% if section.settings.story_image != blank %}
          {{
            section.settings.story_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              sizes: '(max-width: 699px) 100vw, 50vw',
              widths: '400,600,800,1000,1200,1400,1600',
              class: 'ghlam-about__image',
              alt: section.settings.story_image.alt
          }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'ghlam-about__placeholder' }}
        {% endif %}
      </div>
    </div>

    {%- comment -%}
      MISSION SECTION
    {%- endcomment -%}

    <div class="ghlam-about__row ghlam-about__row--mission">
      <div class="ghlam-about__content ghlam-about__content--mission">
        {% if section.settings.mission_heading != blank %}
          <h2 class="ghlam-about__subheading">
            {{ section.settings.mission_heading }}
          </h2>
        {% endif %}

        {% if section.settings.mission_text != blank %}
          <div class="ghlam-about__text rte">
            {{ section.settings.mission_text }}
          </div>
        {% endif %}
      </div>

      <div class="ghlam-about__media ghlam-about__media--mission">
        {% if section.settings.mission_image != blank %}
          {{
            section.settings.mission_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              sizes: '(max-width: 699px) 100vw, 58vw',
              widths: '400,600,800,1000,1200,1400,1600',
              class: 'ghlam-about__image',
              alt: section.settings.mission_image.alt
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'ghlam-about__placeholder' }}
        {% endif %}
      </div>
    </div>

    {%- comment -%}
      VALUES
    {%- endcomment -%}

    {% if section.blocks.size > 0 %}
      <div class="ghlam-about__values">
        {% if section.settings.values_heading != blank %}
          <div class="ghlam-about__section-header">
            <p class="ghlam-about__eyebrow">
              {{ section.settings.values_eyebrow }}
            </p>

            <h2 class="ghlam-about__subheading">
              {{ section.settings.values_heading }}
            </h2>
          </div>
        {% endif %}

        <div class="ghlam-about__values-grid">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'value' %}
                <article
                  class="ghlam-about__value-card"
                  {{ block.shopify_attributes }}
                >
                  <span class="ghlam-about__value-number">
                    {{ forloop.index | prepend: '0' }}
                  </span>

                  {% if block.settings.heading != blank %}
                    <h3>{{ block.settings.heading }}</h3>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <div class="rte">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}
                </article>
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {%- comment -%}
      FINAL BRAND STATEMENT
    {%- endcomment -%}

    <div class="ghlam-about__brand-story">
      <div class="ghlam-about__brand-logo">
        {% if section.settings.brand_logo != blank %}
          {{
            section.settings.brand_logo
            | image_url: width: 500
            | image_tag:
              loading: 'lazy',
              widths: '180,250,350,500',
              class: 'ghlam-about__logo-image',
              alt: section.settings.brand_logo.alt
          }}
        {% else %}
          <span>{{ shop.name }}</span>
        {% endif %}
      </div>

      <div class="ghlam-about__brand-copy">
        {% if section.settings.brand_heading != blank %}
          <h2 class="ghlam-about__subheading">
            {{ section.settings.brand_heading }}
          </h2>
        {% endif %}

        {% if section.settings.brand_text != blank %}
          <div class="ghlam-about__text rte">
            {{ section.settings.brand_text }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            href="{{ section.settings.button_link }}"
            class="ghlam-about__button"
          >
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "GHLAM About Page",
  "tag": "section",
  "class": "section-ghlam-about",
  "settings": [
    {
      "type": "header",
      "content": "General design"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFEFC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#27231F"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text color",
      "default": "#6F6861"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#E4DDD4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#A98455"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Maximum page width",
      "default": 1500
    },
    {
      "type": "range",
      "id": "section_gap",
      "min": 40,
      "max": 180,
      "step": 10,
      "unit": "px",
      "label": "Section spacing",
      "default": 100
    },
    {
      "type": "header",
      "content": "About introduction"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Us"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Introduction",
      "default": "<p>At GHLAM, modest fashion is more than a style.</p><p>It is confidence, elegance, and self-expression.</p><p>Founded with a vision to create timeless modest clothing, GHLAM brings together thoughtful design, premium fabrics, and effortless sophistication.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Main image"
    },
    {
      "type": "header",
      "content": "Our story"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Heading",
      "default": "Designed With Purpose"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story text",
      "default": "<p>GHLAM is dedicated to empowering women to dress with confidence and grace without compromise.</p><p>Every piece is thoughtfully designed to reflect beauty in simplicity, combining contemporary trends with traditional modesty.</p>"
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story image"
    },
    {
      "type": "header",
      "content": "Mission"
    },
    {
      "type": "text",
      "id": "mission_heading",
      "label": "Heading",
      "default": "Our Mission"
    },
    {
      "type": "richtext",
      "id": "mission_text",
      "label": "Mission text",
      "default": "<p>Our mission is to redefine modern modest fashion by blending faith, elegance, and contemporary design.</p><p>We aim to inspire a community of women who view modesty as a true expression of strength, beauty, and self-respect.</p>"
    },
    {
      "type": "image_picker",
      "id": "mission_image",
      "label": "Mission image"
    },
    {
      "type": "header",
      "content": "Values"
    },
    {
      "type": "text",
      "id": "values_eyebrow",
      "label": "Values eyebrow",
      "default": "What Defines Us"
    },
    {
      "type": "text",
      "id": "values_heading",
      "label": "Values heading",
      "default": "Our Values"
    },
    {
      "type": "header",
      "content": "Final brand story"
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Brand logo"
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Heading",
      "default": "The GHLAM Philosophy"
    },
    {
      "type": "richtext",
      "id": "brand_text",
      "label": "Brand story",
      "default": "<p>At GHLAM, we believe modest fashion has a place on every runway and in every wardrobe.</p><p>Our collections are inspired by the confidence that comes from feeling beautiful, comfortable, and true to yourself.</p><p>We value faith, modesty, craftsmanship, quality, and originality at the heart of every piece.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Modesty"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Thoughtful designs created to celebrate confidence, grace, and individuality.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "GHLAM About Page",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "heading": "Modesty",
            "text": "<p>Thoughtful designs that celebrate confidence, grace, and individuality.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Quality",
            "text": "<p>Premium fabrics, refined finishes, and careful attention to every detail.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Craftsmanship",
            "text": "<p>Timeless pieces designed with purpose and created to be worn with confidence.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}