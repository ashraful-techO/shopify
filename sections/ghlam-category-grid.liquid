{{ 'ghlam-category-grid.css' | asset_url | stylesheet_tag }}

<section
  class="ghlam-category-grid"
  style="
    --ghlam-category-bg: {{ section.settings.background_color }};
    --ghlam-category-text: {{ section.settings.text_color }};
    --ghlam-category-overlay: {{ section.settings.overlay_color }};
    --ghlam-category-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --ghlam-category-gap: {{ section.settings.card_gap }}px;
  "
>
  <div class="ghlam-category-grid__container">
    {% if section.settings.heading != blank %}
      <div class="ghlam-category-grid__header">
        <h2 class="ghlam-category-grid__title">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    <div class="ghlam-category-grid__items">
      {% for block in section.blocks %}
        {% assign card_link = block.settings.link %}

        {% if card_link == blank and block.settings.collection != blank %}
          {% assign card_link = block.settings.collection.url %}
        {% endif %}

        <a
          class="ghlam-category-card"
          href="{{ card_link | default: '#' }}"
          {{ block.shopify_attributes }}
          aria-label="{{ block.settings.title | escape }}"
        >
          <div class="ghlam-category-card__media">
            {% if block.settings.image != blank %}
              {% assign image_alt = block.settings.image.alt %}

              {% if image_alt == blank %}
                {% assign image_alt = block.settings.title %}
              {% endif %}

              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'ghlam-category-card__image',
                  loading: 'lazy',
                  widths: '320, 480, 640, 800, 1000, 1200',
                  sizes: '(max-width: 749px) 50vw, 25vw',
                  alt: image_alt
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'ghlam-category-card__placeholder' }}
            {% endif %}

            <div class="ghlam-category-card__overlay"></div>

            <div class="ghlam-category-card__content">
              {% if block.settings.title != blank %}
                <h3 class="ghlam-category-card__title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if block.settings.show_subtitle and block.settings.subtitle != blank %}
                <span class="ghlam-category-card__subtitle">
                  {{ block.settings.subtitle }}
                </span>
              {% endif %}
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GHLAM category grid",
  "tag": "section",
  "class": "shopify-section--ghlam-category-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F8F3EE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay",
      "default": "#2B241F"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "DRESSES"
        },
        {
          "type": "checkbox",
          "id": "show_subtitle",
          "label": "Show subtitle",
          "default": false
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "SHOP NOW"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "GHLAM category grid",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "DRESSES"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "ABAYAS"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "HIJABS"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "SETS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
