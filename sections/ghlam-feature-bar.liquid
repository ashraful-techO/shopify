{{ 'ghlam-feature-bar.css' | asset_url | stylesheet_tag }}

<section class="ghlam-feature-bar">
  <div class="ghlam-feature-bar__inner">
    {% for block in section.blocks %}
      <div class="ghlam-feature" {{ block.shopify_attributes }}>
        {% if block.settings.icon != blank %}
          <img
            src="{{ block.settings.icon | image_url: width: 80 }}"
            alt="{{ block.settings.title | escape }}"
            width="{{ block.settings.icon.width }}"
            height="{{ block.settings.icon.height }}"
            loading="lazy"
          >
        {% endif %}

        <div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Ghlam Feature Bar",
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "WORLDWIDE SHIPPING"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Fast & reliable delivery"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Ghlam Feature Bar",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
