{{ 'ghlam-hero-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ghlam-hero-slider.js' | asset_url }}" defer="defer"></script>

<section
  id="GhlamHero-{{ section.id }}"
  class="ghlam-hero-slider"
  {% if section.settings.allow_transparent_header %}
    allow-transparent-header
  {% endif %}
  data-ghlam-hero
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | escape }}"
  style="
    --ghlam-hero-desktop-height: {{ section.settings.desktop_height }}px;
    --ghlam-hero-mobile-height: {{ section.settings.mobile_height }}px;
    --ghlam-hero-text: {{ section.settings.text_color }};
    --ghlam-hero-button-bg: {{ section.settings.button_background }};
    --ghlam-hero-button-text: {{ section.settings.button_text_color }};
  "
>
  <div class="ghlam-hero-slider__viewport">
    <div class="ghlam-hero-slider__track" data-ghlam-track>
      {% for block in section.blocks %}
        {% liquid
          if forloop.first
            assign image_loading = 'eager'
            assign image_priority = 'high'
          else
            assign image_loading = 'lazy'
            assign image_priority = 'auto'
          endif
        %}

        <article
          class="ghlam-hero-slide{% if forloop.first %} is-active{% endif %}"
          data-ghlam-slide
          data-slide-index="{{ forloop.index0 }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {{ block.shopify_attributes }}
          style="
            --desktop-position-x: {{ block.settings.desktop_position_x }}%;
            --desktop-position-y: {{ block.settings.desktop_position_y }}%;
            --mobile-position-x: {{ block.settings.mobile_position_x }}%;
            --mobile-position-y: {{ block.settings.mobile_position_y }}%;
            --overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
          "
        >
          <div class="ghlam-hero-slide__media">
            {% case block.type %}
              {% when 'image_slide' %}
                {% if block.settings.desktop_image != blank %}
                  {% liquid
                    assign desktop_alt = block.settings.desktop_image.alt

                    if desktop_alt == blank
                      assign desktop_alt = block.settings.heading
                    endif
                  %}

                  {{
                    block.settings.desktop_image
                    | image_url: width: 2400
                    | image_tag:
                      class: 'ghlam-hero-slide__image ghlam-hero-slide__image--desktop',
                      loading: image_loading,
                      fetchpriority: image_priority,
                      widths: '750, 1100, 1500, 1800, 2100, 2400',
                      sizes: '100vw',
                      alt: desktop_alt
                  }}
                {% else %}
                  {{
                    'lifestyle-1'
                    | placeholder_svg_tag: 'ghlam-hero-slide__placeholder ghlam-hero-slide__placeholder--desktop'
                  }}
                {% endif %}

                {% if block.settings.mobile_image != blank %}
                  {% liquid
                    assign mobile_alt = block.settings.mobile_image.alt

                    if mobile_alt == blank
                      assign mobile_alt = block.settings.heading
                    endif
                  %}

                  {{
                    block.settings.mobile_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'ghlam-hero-slide__image ghlam-hero-slide__image--mobile',
                      loading: image_loading,
                      fetchpriority: image_priority,
                      widths: '480, 640, 800, 1000, 1200',
                      sizes: '100vw',
                      alt: mobile_alt
                  }}
                {% elsif block.settings.desktop_image != blank %}
                  {{
                    block.settings.desktop_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'ghlam-hero-slide__image ghlam-hero-slide__image--mobile',
                      loading: image_loading,
                      fetchpriority: image_priority,
                      widths: '480, 640, 800, 1000, 1200',
                      sizes: '100vw',
                      alt: desktop_alt
                  }}
                {% endif %}

              {% when 'video_slide' %}
                {% if block.settings.desktop_video != blank %}
                  {{
                    block.settings.desktop_video
                    | video_tag:
                      class: 'ghlam-hero-slide__video ghlam-hero-slide__video--desktop',
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      preload: 'metadata'
                  }}
                {% elsif block.settings.desktop_poster != blank %}
                  {% liquid
                    assign desktop_poster_alt = block.settings.desktop_poster.alt

                    if desktop_poster_alt == blank
                      assign desktop_poster_alt = block.settings.heading
                    endif
                  %}

                  {{
                    block.settings.desktop_poster
                    | image_url: width: 2400
                    | image_tag:
                      class: 'ghlam-hero-slide__image ghlam-hero-slide__image--desktop',
                      loading: image_loading,
                      fetchpriority: image_priority,
                      widths: '750, 1100, 1500, 1800, 2100, 2400',
                      sizes: '100vw',
                      alt: desktop_poster_alt
                  }}
                {% else %}
                  {{
                    'lifestyle-1'
                    | placeholder_svg_tag: 'ghlam-hero-slide__placeholder ghlam-hero-slide__placeholder--desktop'
                  }}
                {% endif %}

                {% if block.settings.mobile_video != blank %}
                  {{
                    block.settings.mobile_video
                    | video_tag:
                      class: 'ghlam-hero-slide__video ghlam-hero-slide__video--mobile',
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      preload: 'metadata'
                  }}
                {% elsif block.settings.mobile_poster != blank %}
                  {% liquid
                    assign mobile_poster_alt = block.settings.mobile_poster.alt

                    if mobile_poster_alt == blank
                      assign mobile_poster_alt = block.settings.heading
                    endif
                  %}

                  {{
                    block.settings.mobile_poster
                    | image_url: width: 1200
                    | image_tag:
                      class: 'ghlam-hero-slide__image ghlam-hero-slide__image--mobile',
                      loading: image_loading,
                      fetchpriority: image_priority,
                      widths: '480, 640, 800, 1000, 1200',
                      sizes: '100vw',
                      alt: mobile_poster_alt
                  }}
                {% elsif block.settings.desktop_video != blank %}
                  {{
                    block.settings.desktop_video
                    | video_tag:
                      class: 'ghlam-hero-slide__video ghlam-hero-slide__video--mobile',
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      preload: 'metadata'
                  }}
                {% elsif block.settings.desktop_poster != blank %}
                  {{
                    block.settings.desktop_poster
                    | image_url: width: 1200
                    | image_tag:
                      class: 'ghlam-hero-slide__image ghlam-hero-slide__image--mobile',
                      loading: image_loading,
                      fetchpriority: image_priority,
                      widths: '480, 640, 800, 1000, 1200',
                      sizes: '100vw',
                      alt: desktop_poster_alt
                  }}
                {% endif %}
            {% endcase %}
          </div>

          <div class="ghlam-hero-slide__overlay"></div>

          <div
            class="
              ghlam-hero-slide__content
              ghlam-hero-slide__content--desktop-{{ block.settings.desktop_alignment }}
              ghlam-hero-slide__content--mobile-{{ block.settings.mobile_alignment }}
            "
          >
            <div class="ghlam-hero-slide__content-inner">
              {% if block.settings.eyebrow != blank %}
                <p class="ghlam-hero-slide__eyebrow">
                  {{ block.settings.eyebrow }}
                </p>
              {% endif %}

              {% if block.settings.heading != blank %}
                <h2 class="ghlam-hero-slide__heading">
                  {{ block.settings.heading | newline_to_br }}
                </h2>
              {% endif %}

              {% if block.settings.script_text != blank %}
                <p class="ghlam-hero-slide__script">
                  {{ block.settings.script_text }}
                </p>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="ghlam-hero-slide__text">
                  {{ block.settings.text }}
                </div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                {% liquid
                  assign hero_button_link = block.settings.button_link

                  if hero_button_link == blank
                    assign hero_button_link = routes.all_products_collection_url
                  endif
                %}

                <a
                  class="ghlam-hero-slide__button"
                  href="{{ hero_button_link }}"
                >
                  {{ block.settings.button_label }}
                </a>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      {% if section.settings.show_arrows %}
        <button
          class="ghlam-hero-slider__arrow ghlam-hero-slider__arrow--previous"
          type="button"
          aria-label="Previous slide"
          data-ghlam-previous
        >
          <span aria-hidden="true">‹</span>
        </button>

        <button
          class="ghlam-hero-slider__arrow ghlam-hero-slider__arrow--next"
          type="button"
          aria-label="Next slide"
          data-ghlam-next
        >
          <span aria-hidden="true">›</span>
        </button>
      {% endif %}

      {% if section.settings.show_dots %}
        <div
          class="ghlam-hero-slider__dots"
          role="group"
          aria-label="Slideshow navigation"
        >
          {% for block in section.blocks %}
            <button
              class="ghlam-hero-slider__dot{% if forloop.first %} is-active{% endif %}"
              type="button"
              aria-label="Go to slide {{ forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              data-ghlam-dot="{{ forloop.index0 }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "GHLAM hero slider",
  "tag": "section",
  "class": "shopify-section--ghlam-hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "Allow transparent header",
      "info": "Uses the native Prestige transparent header when this is the first homepage section.",
      "default": true
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Homepage promotional slideshow"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 500,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 500,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slide every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Hero text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#B89A5A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "image_slide",
      "name": "Image slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Use a portrait image for the best mobile result."
        },
        {
          "type": "range",
          "id": "desktop_position_x",
          "label": "Desktop horizontal position",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "desktop_position_y",
          "label": "Desktop vertical position",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "mobile_position_x",
          "label": "Mobile horizontal position",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "mobile_position_y",
          "label": "Mobile vertical position",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 70,
          "step": 5,
          "unit": "%",
          "default": 10
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small text"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "default": "WRAPPED IN GLAMOUR\nROOTED IN MODESTY"
        },
        {
          "type": "text",
          "id": "script_text",
          "label": "Script text",
          "default": "Elegantly Yours"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "SHOP THE COLLECTION"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "desktop_alignment",
          "label": "Desktop content position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "mobile_alignment",
          "label": "Mobile content position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        }
      ]
    },
    {
      "type": "video_slide",
      "name": "Video slide",
      "settings": [
        {
          "type": "video",
          "id": "desktop_video",
          "label": "Desktop video"
        },
        {
          "type": "image_picker",
          "id": "desktop_poster",
          "label": "Desktop fallback image"
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video"
        },
        {
          "type": "image_picker",
          "id": "mobile_poster",
          "label": "Mobile fallback image"
        },
        {
          "type": "range",
          "id": "desktop_position_x",
          "label": "Desktop horizontal position",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "desktop_position_y",
          "label": "Desktop vertical position",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "mobile_position_x",
          "label": "Mobile horizontal position",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "mobile_position_y",
          "label": "Mobile vertical position",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 70,
          "step": 5,
          "unit": "%",
          "default": 15
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small text"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "default": "WRAPPED IN GLAMOUR\nROOTED IN MODESTY"
        },
        {
          "type": "text",
          "id": "script_text",
          "label": "Script text",
          "default": "Elegantly Yours"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "SHOP THE COLLECTION"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "desktop_alignment",
          "label": "Desktop content position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "mobile_alignment",
          "label": "Mobile content position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "GHLAM hero slider",
      "blocks": [
        {
          "type": "image_slide"
        }
      ]
    }
  ]
}
{% endschema %}
