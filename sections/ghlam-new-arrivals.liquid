{{ 'ghlam-new-arrivals.css' | asset_url | stylesheet_tag }}

<section
  class="ghlam-new-arrivals"
  style="
    --ghlam-section-bg: {{ section.settings.background_color }};
    --ghlam-section-text: {{ section.settings.text_color }};
    --ghlam-section-muted: {{ section.settings.muted_text_color }};
    --ghlam-section-border: {{ section.settings.border_color }};
  "
>
  <div class="ghlam-new-arrivals__container">
    <div class="ghlam-new-arrivals__header">
      <h2 class="ghlam-new-arrivals__title">
        {{ section.settings.heading }}
      </h2>

      {% comment %}
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a
            class="ghlam-new-arrivals__view-all"
            href="{{ section.settings.collection.url }}"
          >
            {{ section.settings.view_all_label }}
          </a>
        {% endif %}
      {% endcomment %}

      {% if section.settings.show_view_all %}
        <a
          class="ghlam-new-arrivals__view-all"
          href="{% if section.settings.view_all_url != blank %}{{ section.settings.view_all_url }}{% elsif section.settings.collection != blank %}{{ section.settings.collection.url }}{% else %}#{% endif %}"
        >
          {{ section.settings.view_all_label }}
        </a>
      {% endif %}
    </div>

    {% assign selected_collection = section.settings.collection %}

    {% if selected_collection != blank and selected_collection.products_count > 0 %}
      <div class="ghlam-new-arrivals__viewport">
        <div
          class="ghlam-new-arrivals__track"
          id="GhlamNewArrivalsTrack-{{ section.id }}"
        >
          {% for product in selected_collection.products limit: section.settings.products_to_show %}
            <article class="ghlam-product-card">
              <a
                class="ghlam-product-card__media"
                href="{{ product.url }}"
                aria-label="{{ product.title | escape }}"
              >
                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      class: 'ghlam-product-card__image',
                      loading: 'lazy',
                      widths: '240, 360, 480, 640, 900',
                      sizes: '(max-width: 749px) 50vw, 25vw',
                      alt: product.featured_image.alt
                    | default: product.title
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'ghlam-product-card__placeholder' }}
                {% endif %}
              </a>

              <div class="ghlam-product-card__content">
                <a
                  class="ghlam-product-card__title"
                  href="{{ product.url }}"
                >
                  {{ product.title }}
                </a>

                <div class="ghlam-product-card__price">
                  {% if product.compare_at_price > product.price %}
                    <span class="ghlam-product-card__price-sale">
                      {{ product.price | money }}
                    </span>

                    <s class="ghlam-product-card__price-compare">
                      {{ product.compare_at_price | money }}
                    </s>
                  {% else %}
                    {{ product.price | money }}
                  {% endif %}
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>

      {% if section.settings.show_mobile_dots %}
        <div class="ghlam-new-arrivals__dots" aria-hidden="true">
          {% assign product_count = selected_collection.products_count | at_most: section.settings.products_to_show %}
          {% assign mobile_pages = product_count | plus: 1 | divided_by: 2 %}

          {% for i in (1..mobile_pages) %}
            <button
              class="ghlam-new-arrivals__dot{% if forloop.first %} is-active{% endif %}"
              type="button"
              tabindex="-1"
              data-page="{{ forloop.index0 }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    {% else %}
      <div class="ghlam-new-arrivals__empty">Select a collection in the Theme Editor.</div>
    {% endif %}
  </div>
</section>

<script>
  (() => {
    const section = document.currentScript.closest('.shopify-section');
    if (!section) return;

    const track = section.querySelector('.ghlam-new-arrivals__track');
    const dots = section.querySelectorAll('.ghlam-new-arrivals__dot');

    if (!track || dots.length === 0) return;

    const updateDots = () => {
      const pageWidth = track.clientWidth;
      if (!pageWidth) return;

      const page = Math.round(track.scrollLeft / pageWidth);

      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === page);
      });
    };

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        track.scrollTo({
          left: track.clientWidth * index,
          behavior: 'smooth',
        });
      });
    });

    track.addEventListener('scroll', updateDots, { passive: true });
    window.addEventListener('resize', updateDots);
  })();
</script>

{% schema %}
{
  "name": "GHLAM new arrivals",
  "tag": "section",
  "class": "shopify-section--ghlam-new-arrivals",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All label",
      "default": "VIEW ALL"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_dots",
      "label": "Show mobile slider dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F8F3EE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2B241F"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "#6F655D"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#E4D9CD"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View All URL"
    }
  ],
  "presets": [
    {
      "name": "GHLAM new arrivals"
    }
  ]
}
{% endschema %}
