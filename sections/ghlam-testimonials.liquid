{{ 'ghlam-testimonials.css' | asset_url | stylesheet_tag }}

<section class="ghlam-testimonials">
  <div class="page-width">
    <h2>{{ section.settings.heading }}</h2>

    <div class="ghlam-testimonials__grid">
      {% for block in section.blocks %}
        <div class="ghlam-review" {{ block.shopify_attributes }}>
          <div class="ghlam-review__quote">“</div>

          <p class="ghlam-review__text">
            {{ block.settings.review }}
          </p>

          <span class="ghlam-review__author"> — {{ block.settings.author }} </span>
        </div>
      {% endfor %}
    </div>

    <div class="ghlam-rating">
      <div class="ghlam-stars">★★★★★</div>

      <span>
        {{ section.settings.rating }}
      </span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ghlam Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LOVED BY OUR COMMUNITY"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating text",
      "default": "4.9/5 FROM 500+ REVIEWS"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "review",
          "label": "Review",
          "default": "The quality is unmatched and the designs are so elegant. Ghlam has become my go-to for every occasion."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Amina"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Ghlam Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "review": "The quality is unmatched and the designs are so elegant. Ghlam has become my go-to for every occasion.",
            "author": "Amina"
          }
        },
        {
          "type": "review",
          "settings": {
            "review": "Finally a brand that truly understands modesty and style. Every piece feels luxurious.",
            "author": "Sara"
          }
        },
        {
          "type": "review",
